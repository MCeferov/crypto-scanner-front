# ─── Backend API ──────────────────────────────────────────────────
# Absolute origin of the backend. Baked into the bundle at BUILD time, so it
# must be set before `pnpm build` — changing it later requires a rebuild.
#
# Leave EMPTY for local development: the Vite dev server proxies /api to
# API_PROXY_TARGET below, which keeps requests same-origin.
#
# Production (Netlify env var):
#   VITE_API_URL=https://crypto-heatmap-backend.up.railway.app
VITE_API_URL=

# ─── Local dev only (never used by the production bundle) ─────────
# Where `pnpm dev` proxies /api requests. Must match the backend's PORT.
API_PROXY_TARGET=http://localhost:3000

# Vite dev/preview server port. Defaults to 5173 when unset.
# PORT=5173

# Sub-path the app is served from. Defaults to "/" when unset.
# BASE_PATH=/
