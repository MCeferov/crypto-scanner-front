# ─── Backend API ──────────────────────────────────────────────────
# Absolute origin of the backend. Baked into the bundle at BUILD time, so it
# must be set before `pnpm build` — changing it later requires a rebuild.
#
# Leave EMPTY unless the backend moves: dev and production both default to
#   https://crypto-scanner-back-production.up.railway.app
# and call it directly, so DevTools shows the real backend URL.
#
# The backend must allow this app's origin via CORS (its FRONTEND_URL
# allowlist), otherwise the browser blocks every call.
#
# Special value: VITE_API_URL=proxy keeps requests same-origin and routes
# /api through the Vite dev proxy below — use it when CORS is not set up yet.
VITE_API_URL=

# ─── Local dev only (never used by the production bundle) ─────────
# Where the dev server proxies /api when VITE_API_URL=proxy. Defaults to the
# Railway backend; point it at a local API to develop against one.
# API_PROXY_TARGET=http://localhost:3000

# Vite dev/preview server port. Defaults to 5173 when unset.
# PORT=5173

# Sub-path the app is served from. Defaults to "/" when unset.
# BASE_PATH=/

# ─── Cədvəl ölçüsü ────────────────────────────────────────────────
# Neçə kripto cütü göstərilsin. Default 40, maksimum 100.
# Hər aktiv üçün 7 timeframe kline çəkilir, ona görə yüksək dəyər ilk
# yüklənməni uzadır.
# VITE_CRYPTO_LIMIT=40
